    "scripts/consumers/group-query-owner-consumer-contract.mjs",
    "scripts/consumers/contact-group-snapshot-consumer-contract.mjs",
    "scripts/consumers/request-result-consumer-contract.mjs",
    "scripts/consumers/element-preparation-consumer-contract.mjs",
    "scripts/consumers/mirror-consumer-contract.mjs",
    "scripts/consumers/group-essence-consumer-contract.mjs",
    "scripts/consumers/group-file-pages-consumer-contract.mjs",
    "scripts/consumers/worker-delivery-consumer-contract.mjs"
