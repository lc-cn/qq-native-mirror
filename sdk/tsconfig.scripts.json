    "scripts/group-query-owner-consumer-contract.mjs",
    "scripts/contact-group-snapshot-consumer-contract.mjs",
    "scripts/request-result-consumer-contract.mjs",
    "scripts/element-preparation-consumer-contract.mjs",
    "scripts/mirror-consumer-contract.mjs",
    "scripts/group-essence-consumer-contract.mjs",
    "scripts/group-file-pages-consumer-contract.mjs",
    "scripts/worker-delivery-consumer-contract.mjs"
  ]
}
