{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "scripts/consumers/**/*.mjs",
    "scripts/verify-package-consumer.mjs",
    "scripts/node-license-download.mjs",
    "test/**/*.mjs"
  ]
}
